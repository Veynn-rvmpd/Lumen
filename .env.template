# LUMEN-CORE Environment Configuration Template
# Copy this file to .env and supply the required values.

# System & Dashboard
LUMEN_ENV=production
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=5000
DASHBOARD_DEBUG=false
LOG_LEVEL=INFO

# Spotify Web API
# Obtain from https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
SPOTIFY_REDIRECT_URI=http://localhost:5000/callback/spotify

# Steam Integration
# Leave blank to detect default Windows installation paths automatically
STEAM_INSTALL_PATH=C:\Program Files (x86)\Steam

# WhatsApp Priority Notifier
# Provider options: twilio, cloud_api, console_fallback
WHATSAPP_PROVIDER=console_fallback
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=+14155238886
WHATSAPP_RECIPIENT_NUMBER=

# Telegram Bot
# Obtain bot token from @BotFather
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=

# Gmail Triage & Inbox Sentinel
# Use a dedicated Google App Password: https://myaccount.google.com/apppasswords
GMAIL_USER_EMAIL=
GMAIL_APP_PASSWORD=
IMAP_SERVER=imap.gmail.com

# Amazon Assistant
AMAZON_MARKETPLACE_DOMAIN=amazon.com
AMAZON_HEADLESS_BROWSER=true

# Storage & Sentinel Directories
FILE_ORGANIZER_WATCH_PATH=C:\Users\Public\Downloads
TRASH_RETENTION_DAYS=7
